{
    "name": "utd-chess-bots",
    "private": true,
    "version": "0.0.0",
    "workspaces": [
        "src/client",
        "src/server"
    ],
    "scripts": {
        "dev": "ts-node src/server/main.ts",
        "devup": "nodemon src/server/main.ts",
        "start": "NODE_ENV=production ts-node ./src/server/main.ts",
        "build": "vite build",
        "docs:build": "typedoc",
        "docs:dev": "nodemon --exec 'yarn run docs:build' --watch ./tsconfig.json,./src/**/*,./docs/**/*",
        "test": "vitest",
        "format": "prettier --write src/**",
        "format-check": "prettier --check src/**",
        "lint": "eslint . --fix --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "lint-check": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
    },
    "dependencies": {
        "cbor-x": "^1.6.8",
        "chess.js": "^1.4.0",
        "typescript": "^6.0.3",
        "vite-express": "^0.22.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^9.34.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "eslint-plugin-tsdoc": "^0.5.4",
        "lunr": "^2.3.9",
        "nodemon": "^3.1.14",
        "prettier": "^3.9.10",
        "ts-node": "^10.9.2",
        "typedoc": "^0.28.20",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "optionalDependencies": {
        "bufferutil": "^4.0.8"
    },
    "packageManager": "yarn@4.13.0"
}
